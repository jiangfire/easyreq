# Database
DATABASE_URL="postgresql://user:password@localhost:5432/easyreq"
# Test database (auto-derived as <DATABASE_URL db>_test by vitest; override here if needed).
# Integration tests refuse to run unless the DSN looks like a test database.
# DATABASE_TEST_URL="postgresql://user:password@localhost:5432/easyreq_test"

# NextAuth
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
# Must match the port your dev server runs on (see PORT below).
NEXTAUTH_URL="http://localhost:3000"

# Server port (Next.js reads this automatically; change if 3000 is taken).
PORT=3000

# File Storage
# STORAGE_PROVIDER: local | s3
STORAGE_PROVIDER=local
# Local storage directory (when STORAGE_PROVIDER=local).
# IMPORTANT: must NOT live under public/, otherwise Next.js serves files
# directly and bypasses the /api/attachments/:id permission check.
STORAGE_LOCAL_DIR=./uploads
# Max upload size in bytes (default 10MB)
STORAGE_MAX_FILE_SIZE=10485760

# S3 Compatible Storage (when STORAGE_PROVIDER=s3)
# Works with AWS S3, MinIO, Aliyun OSS, etc.
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
# Optional public base URL for S3 objects (if served via CDN)
S3_PUBLIC_URL=
# Set to "true" for MinIO and other path-style endpoints
S3_FORCE_PATH_STYLE=false
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# AI Plugin (optional, disabled by default)
# AI_ENABLED=false → NullAIProvider，所有 AI 调用 no-op
# AI_ENABLED=true  → 按 AI_PROVIDER 选实现
AI_ENABLED=false
# AI_PROVIDER=heuristic   # 默认，零依赖，离线关键词匹配
# AI_PROVIDER=openai       # OpenAI 兼容 HTTP（需要 AI_API_KEY）
# AI_API_KEY=sk-...        # 仅 OpenAI 模式需要
# AI_BASE_URL=https://api.openai.com/v1   # 可换成 Ollama/vLLM 等
# AI_MODEL=gpt-4o-mini

# Redis pub/sub for cross-instance SSE (optional)
# Unset or empty → in-memory EventEmitter (single-instance)
# Set → try Redis pub/sub; falls back to in-memory if connection fails
# REDIS_URL="redis://localhost:6379"
